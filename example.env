# Copiá este archivo a .env y completá los valores.
# .env no se sube a git (está en .gitignore).
#
# Datos de WhatsApp ya documentados en el repo:
#   - ACTUALIZAR-PHONE-ID.md  → Phone Number ID y número ONDA
#   - CONFIGURACION-ACTUAL.md → webhook URL y números
#   - docs/WHATSAPP-CONFIG.md → resumen y dónde está cada dato

# --- OpenAI (obligatorio para chat, transcripción, TTS e imágenes) ---
OPENAI_API_KEY=sk-...

# --- WhatsApp Cloud API (obligatorio para que ONDA responda por WhatsApp) ---
# Token que elegís vos; Meta lo envía al verificar el webhook y debe coincidir.
# Ej.: onda_verify_precisar_2026 (mismo valor en Meta y en Vercel).
WHATSAPP_VERIFY_TOKEN=una_frase_secreta_que_inventes

# Token de acceso (Meta → WhatsApp → API Setup). Temporal o permanente.
WHATSAPP_ACCESS_TOKEN=EAAxxxx...

# ID del número de teléfono conectado a la app (solo dígitos).
# Para ONDA (+56 9 9155 3279) el ID documentado es: 886309674569527 (ver ACTUALIZAR-PHONE-ID.md).
WHATSAPP_PHONE_NUMBER_ID=886309674569527

# Opcional pero recomendado en producción: firma del webhook (App Secret en Meta).
WHATSAPP_APP_SECRET=xxxx
# O: META_APP_SECRET=xxxx

# Opcional: versión de la API de Meta (por defecto v24.0).
# GRAPH_VERSION=v24.0

# --- Webhook (solo referencia; la URL se configura en Meta) ---
# URL documentada para este proyecto: https://onda2026.vercel.app/api/webhook

# --- Otros (según usés) ---
# Firebase/RAG, Tavily, etc.
