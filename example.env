# Plantilla de variables — copiá a .env o .env.local (no subir a git).
# Comandos fijos (dev, env, tests): sección "Lo más simple" en docs/ENTORNO-VERCEL-Y-LOCAL.md
# Guía completa y flujo seguro con Vercel: docs/ENTORNO-VERCEL-Y-LOCAL.md
# WhatsApp paso a paso: docs/WHATSAPP-CONFIG.md

# =============================================================================
# MÍNIMO PARA CHAT WEB (local o Vercel)
# =============================================================================
OPENAI_API_KEY=sk-...

# URL pública canónica (chat + webhook en el mismo proyecto). Preview u otro dominio: descomentá y ajustá.
# NEXT_PUBLIC_ONDA_PUBLIC_URL=https://onda.precisar.net

# TTS “Escuchar” en el chat: voz femenina y más natural en español que alloy (probar shimmer si preferís otro timbre).
# OPENAI_TTS_VOICE=nova
# Más calidad / prosodia (más lento y caro): OPENAI_TTS_MODEL=tts-1-hd

# =============================================================================
# WHATSAPP (Meta Cloud API) — ver GET/POST en /api/webhook
# =============================================================================
WHATSAPP_VERIFY_TOKEN=una_frase_secreta_que_inventes
WHATSAPP_ACCESS_TOKEN=EAAxxxx...
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# ID de la cuenta WhatsApp Business (WABA), útil para administración / auditoría.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Firma de los POST de Meta (X-Hub-Signature-256). Suele ser el App Secret de la app.
WHATSAPP_WEBHOOK_SECRET=xxxx

# Recomendado (mismo valor que arriba o clave de app en Meta).
WHATSAPP_APP_SECRET=xxxx
META_APP_SECRET=xxxx

GRAPH_VERSION=v24.0

# ---- Plantillas HSM aprobadas en WhatsApp Manager ----------------------------
# Nombres EXACTOS aprobados por Meta. Sin ellos, fuera de ventana 24 h el bot
# NO envía nada (sólo se permiten plantillas). Cargar después de aprobación.
WHATSAPP_TEMPLATE_REACTIVATION=
WHATSAPP_TEMPLATE_WELCOME_OPTIN=
WHATSAPP_TEMPLATE_SERVICE_NOTICE=
WHATSAPP_TEMPLATE_LANGUAGE=es

# ---- Secrets de privacidad y diagnóstico -------------------------------------
# Generar ambos con: npm run secrets:generate
# NUNCA reutilizar entre entornos (dev ≠ staging ≠ prod) ni commitear valores.

# WHATSAPP_LOG_PEPPER
# Salt criptográfico para hashear números de teléfono en logs.
# OBLIGATORIO en producción — sin esto los hashes son inseguros y reversibles.
# Formato: string hex de 64 caracteres (32 bytes). Si vacío, cae a WHATSAPP_WEBHOOK_SECRET.
WHATSAPP_LOG_PEPPER=

# `1` activa preview de texto en logs SOLO en desarrollo. Producción: vacío.
WHATSAPP_LOG_DEBUG=

# WHATSAPP_DIAG_TOKEN
# Token de acceso al endpoint de diagnóstico GET /api/webhook.
# OBLIGATORIO en producción. Enviar en header: x-onda-diag-token: <valor>.
WHATSAPP_DIAG_TOKEN=

# =============================================================================
# ORQUESTADOR (opcional pero recomendado en producción)
# =============================================================================
# Claude para consultas "deep" cuando exista clave:
ANTHROPIC_API_KEY=

# Gemini (docs largos / fallback): cualquiera de estas (ondaReply / geminiService)
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENAI_API_KEY=
# GEMINI_API_KEY=
# API_KEY=

# =============================================================================
# BÚSQUEDA WEB (opcional pero recomendada para Modo Desinformación 360 y fact-check)
# Sin clave: el bot sigue funcionando y declara con transparencia que no tiene
# evidencia externa. NUNCA inventa fuentes.
# Prioridad: TAVILY_API_KEY > SERPER_API_KEY.
# =============================================================================
TAVILY_API_KEY=
# SERPER_API_KEY=

# =============================================================================
# FIREBASE / RAG PRIVADO (opcional — sin esto, RAG interno queda vacío)
# =============================================================================
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# =============================================================================
# VERCEL KV (obligatorio en Vercel si querés evitar errores en logs: memoria de sesión,
# rate limit, caché, métricas, auditoría). Crear KV en el proyecto Vercel y enlazar variables.
# =============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# =============================================================================
# ADMIN (dashboard / métricas / purge / spending)
# =============================================================================
# Secret del panel de administración y endpoints /api/admin/*
# Generar con: npm run secrets:generate
ADMIN_SECRET=

# =============================================================================
# UI / OPS
# =============================================================================
# NEXT_PUBLIC_ONDA_ORANGE=#FF4500
# Umbrales en USD (por defecto 5 y 20 si no definís)
# SPENDING_ALERT_DAILY_USD=5
# SPENDING_ALERT_CRITICAL_USD=20
# Webhook opcional (Slack/Discord) cuando supera umbral
# SPENDING_ALERT_WEBHOOK_URL=

# ── VARIABLES SINCRONIZADAS ──────────────────────────────
# Última sincronización: 2026-07-06
# Si agregas una variable a .env.example, agrégala también a example.env
