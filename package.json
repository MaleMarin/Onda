{
  "name": "ondabot",
  "version": "1.0.0",
  "description": "Backend minimal de Onda (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev -p 3020",
    "backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:fresh": "lsof -ti :3020 | xargs kill -9 2>/dev/null; next dev -p 3020",
    "dev:3000": "next dev -p 3000",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "start:express": "node dist/index.js",
    "build:tsc": "tsc",
    "next:dev": "next dev",
    "next:dev:3010": "next dev -p 3010",
    "chat": "next dev -p 3020",
    "next:build": "next build",
    "next:start": "next start",
    "ingest": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/ingestToFirestore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "@google-cloud/firestore": "^7.0.0",
    "@google/genai": "^1.42.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/kv": "^0.2.0",
    "@vercel/node": "^5.5.28",
    "ai": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.0.0",
    "next": "^14.2.0",
    "openai": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "pdf-parse": "^1.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
