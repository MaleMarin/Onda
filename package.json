{
  "name": "ondabot",
  "version": "1.0.0",
  "description": "Backend minimal de Onda (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev -p 2999",
    "dev:fresh": "lsof -ti :2999 | xargs kill -9 2>/dev/null; next dev -p 2999",
    "dev:3000": "next dev -p 3000",
    "dev:3001": "next dev -p 3001",
    "backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "next build",
    "start": "next start",
    "start:express": "node dist/index.js",
    "build:tsc": "tsc",
    "next:dev": "next dev",
    "next:dev:3010": "next dev -p 3010",
    "chat": "next dev -p 2999",
    "next:build": "next build",
    "next:start": "next start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@vercel/node": "^5.5.28",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "next": "^14.2.0",
    "openai": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
