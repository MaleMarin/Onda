# Variables de entorno para ONDA WhatsApp Bot
# Copiá este archivo a `.env.local` para desarrollo. En Vercel, configurá las
# mismas claves en Settings → Environment Variables.
#
# IMPORTANTE: NUNCA versionar archivos con valores reales. Este archivo solo
# documenta las claves esperadas. Los secretos viven en .env.local / Vercel.

# =============================================================================
# WHATSAPP CLOUD API (Meta) — obligatorias en producción
# =============================================================================

# Cadena propia (inventada por vos) usada en el handshake GET del webhook.
# DEBE coincidir con la que pongas en Meta al suscribir el webhook.
WHATSAPP_VERIFY_TOKEN=

# Token de acceso de larga duración generado en Meta → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de WhatsApp Business (Meta → API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA). Se usa para administración
# (plantillas, números asociados). Útil para diagnóstico y auditoría.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# App Secret de la app de Meta. Es el secreto que Meta usa para firmar cada
# POST entrante (header x-hub-signature-256). Sin esto el webhook rechaza
# todos los POST (status 401). Configurarlo idéntico al panel de Meta.
WHATSAPP_WEBHOOK_SECRET=

# Mismo App Secret expuesto también con el nombre estándar de Meta. Algunas
# integraciones esperan META_APP_SECRET; mantenerlo en sync con el anterior.
META_APP_SECRET=

# Versión de Graph API que se usa en todas las llamadas a Meta.
# Default: v24.0. Actualizar cuando Meta deprecate la versión actual.
GRAPH_VERSION=v24.0

# =============================================================================
# PLANTILLAS HSM APROBADAS (Meta WhatsApp Manager)
# -----------------------------------------------------------------------------
# Fuera de la ventana de 24 h, Meta SOLO permite mensajes basados en
# plantillas previamente aprobadas. Estas variables guardan los nombres
# EXACTOS aprobados; sin ellas, fuera de ventana NO se envía nada.
# Antes de pasar a producción:
#   1. Crear las plantillas en WhatsApp Manager → Plantillas de mensajes.
#   2. Esperar aprobación de Meta (puede tardar minutos u horas).
#   3. Pegar el nombre técnico aprobado en estas variables.
# =============================================================================
WHATSAPP_TEMPLATE_REACTIVATION=
WHATSAPP_TEMPLATE_WELCOME_OPTIN=
WHATSAPP_TEMPLATE_SERVICE_NOTICE=
# Código de idioma Meta (ej.: es, es_AR, pt_BR). Debe coincidir con el de las
# plantillas. Default: es.
WHATSAPP_TEMPLATE_LANGUAGE=es

# =============================================================================
# OPENAI — modelo, audio y visión
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# VERCEL KV (Storage distribuido) — obligatorio en producción
# -----------------------------------------------------------------------------
# Se usa para: dedupe de message.id, opt-out, primer contacto, ventana 24 h,
# locks, rate limit y memoria de sesión. Sin estas variables el bot funciona
# en modo "fail-open" y NO sobrevive cold starts ni múltiples instancias.
# Configuración: Vercel Dashboard → Storage → KV → Connect to project.
# =============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# =============================================================================
# SECRETS DE PRIVACIDAD Y DIAGNÓSTICO
# -----------------------------------------------------------------------------
# Generar ambos con: npm run secrets:generate
# NUNCA reutilizar entre entornos (dev ≠ staging ≠ prod).
# NUNCA commitear los valores generados.
# =============================================================================

# WHATSAPP_LOG_PEPPER
# Salt criptográfico para hashear números de teléfono en logs.
# OBLIGATORIO en producción — sin esto los hashes son inseguros y reversibles.
# Generar con: npm run secrets:generate
# Formato: string hex de 64 caracteres (32 bytes).
# Si se deja vacío, lib/waSafeLog.ts cae a WHATSAPP_WEBHOOK_SECRET; aceptable
# en dev, NO recomendable en producción.
WHATSAPP_LOG_PEPPER=

# Activá `1` SOLO en desarrollo para imprimir preview del texto del usuario
# en los logs. En producción debe quedar vacío o `0`.
WHATSAPP_LOG_DEBUG=

# WHATSAPP_DIAG_TOKEN
# Token de acceso al endpoint de diagnóstico GET /api/webhook.
# OBLIGATORIO en producción — sin esto cualquiera puede ver métricas internas.
# Generar con: npm run secrets:generate (formato: hex de 48 caracteres / 24 bytes).
# Enviar en header: x-onda-diag-token: <valor>
WHATSAPP_DIAG_TOKEN=

# =============================================================================
# BÚSQUEDA WEB EN VIVO (Modo Desinformación 360 / verificación)
# Sin estas claves el bot sigue funcionando pero declara con transparencia
# que no tiene evidencia externa. NUNCA inventa fuentes.
# Prioridad: TAVILY_API_KEY > SERPER_API_KEY.
# =============================================================================
TAVILY_API_KEY=
# SERPER_API_KEY=
